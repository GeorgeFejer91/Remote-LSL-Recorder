{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remote LSL Recorder",
  "version": "0.1.4",
  "identifier": "dev.georgefejer.remotelslrecorder",
  "build": {
    "beforeBuildCommand": "pnpm prepare:web",
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https://*.vdo.ninja wss://*.vdo.ninja; media-src 'none'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Remote LSL Recorder",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "View and record LSL streams",
    "longDescription": "Discover, view, and record Lab Streaming Layer streams to XDF with an opt-in browser companion.",
    "resources": {
      "../vendor/labrecorder-win/*": "labrecorder/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    }
  }
}
